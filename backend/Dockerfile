FROM node:20-alpine

# Definir argumentos de construcción
ARG ORIGIN
ARG DOMAIN
ARG EMAIL
ARG JWT_SECRET_KEY
ARG AWS_S3_BUCKET
ARG AWS_REGION
ARG AWS_ACCESS_KEY_ID
ARG AWS_SECRET_ACCESS_KEY
ARG AWS_FOLDER
ARG PORT
ARG DATABASE_URL

# Definir variables de entorno en el contenedor
ENV ORIGIN=${ORIGIN}
ENV DOMAIN=${DOMAIN}
ENV EMAIL=${EMAIL}
ENV JWT_SECRET_KEY=${JWT_SECRET_KEY}
ENV AWS_S3_BUCKET=${AWS_S3_BUCKET}
ENV AWS_REGION=${AWS_REGION}
ENV AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
ENV AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
ENV AWS_FOLDER=${AWS_FOLDER}
ENV PORT=${PORT}
ENV DATABASE_URL=${DATABASE_URL}

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
EXPOSE 3000
#CMD npm run dev
CMD ["npm","run","start"]


